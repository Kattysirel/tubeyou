# Copiar a .env (nunca subir .env al repositorio)
# Local: si DATABASE_URL no existe se usa SQLite. Produccion: PostgreSQL en RDS.
DATABASE_URL=postgresql+psycopg://tubeyou:CAMBIAR@localhost:5432/tubeyou
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# local | s3
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000

# Solo si STORAGE_BACKEND=s3 (las credenciales las da el IAM Role de la EC2)
AWS_REGION=us-east-1
S3_VIDEOS_BUCKET=tubeyou-videos
S3_THUMBS_BUCKET=tubeyou-miniaturas
