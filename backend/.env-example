# ==========================================
# Configuración Amazon RDS (PostgreSQL)
# ==========================================
DB_USER=postgres
DB_PASSWORD=tu_contraseña_rds
DB_HOST=tu-rds-instance.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=tubeyou_db

# ==========================================
# Configuración de Seguridad y JWT
# ==========================================
JWT_SECRET_KEY=clave_secreta_segura_para_firmar_tokens_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Configuración Amazon S3
# En EC2 con IAM Role NO se requieren credenciales estáticas.
# ==========================================
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=tubeyou-videos-tu-identificador
S3_BUCKET_THUMBNAILS=tubeyou-miniaturas-tu-identificador
