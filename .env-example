# ==========================================
# Configuración Amazon RDS (PostgreSQL)
# ==========================================
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura
DB_HOST=tu_endpoint_rds.amazonaws.com
DB_PORT=5432
DB_NAME=tubeyou_db

# ==========================================
# Configuración de Seguridad y JWT
# ==========================================
JWT_SECRET_KEY=cambiar_por_una_clave_secreta_segura_y_larga_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Configuración Amazon S3
# En EC2 con IAM Role no se requieren credenciales estáticas.
# ==========================================
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=tu-bucket-s3-videos
S3_BUCKET_THUMBNAILS=tu-bucket-s3-miniaturas

# Opcional (solo si se prueba localmente sin IAM Role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
