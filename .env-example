# ==========================================
# Resumen de variables de entorno de TubeYou
# (copiar backend/.env-example a backend/.env y frontend/.env-example a frontend/.env.local)
# ==========================================

# ---------- Backend (backend/.env) ----------
# Local: si no defines DATABASE_URL se usa SQLite. En AWS: PostgreSQL en Amazon RDS.
DATABASE_URL=postgresql+psycopg://postgres:tu_contraseña_rds@tu-endpoint-rds.us-east-1.rds.amazonaws.com:5432/tubeyou
SECRET_KEY=cambiar_por_una_clave_secreta_larga_y_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=720

# URL del sitio (S3) que puede llamar a la API
CORS_ORIGINS=http://tu-bucket-frontend.s3-website-us-east-1.amazonaws.com

# local | s3   (en la EC2 con IAM Role no se necesitan claves de AWS)
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
S3_VIDEOS_BUCKET=tubeyou-videos-tu-sufijo
S3_THUMBS_BUCKET=tubeyou-miniaturas-tu-sufijo

# ---------- Frontend (frontend/.env.local) ----------
VITE_API_URL=http://IP-PUBLICA-DE-LA-EC2

# ---------- GitHub Actions (Settings > Secrets and variables > Actions) ----------
# Secret:     AWS_ROLE_ARN
# Variables:  AWS_REGION, S3_BUCKET_NAME, VITE_API_URL, CLOUDFRONT_DISTRIBUTION_ID (opcional)
