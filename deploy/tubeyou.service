[Unit]
Description=TubeYou API (FastAPI)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/tubeyou/backend
# DATABASE_URL, SECRET_KEY, CORS_ORIGINS, S3_*... viven aqui, fuera del repositorio
EnvironmentFile=/etc/tubeyou.env
ExecStart=/opt/tubeyou/backend/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
